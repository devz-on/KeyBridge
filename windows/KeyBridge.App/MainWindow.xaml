<Window x:Class="KeyBridge.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="KeyBridge" Icon="KeyBridge.ico" Style="{StaticResource {x:Type Window}}" Width="1240" Height="850" MinWidth="860" MinHeight="640" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="212" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Background="#232038" Padding="18,26,18,20">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Margin="6,0,0,28">
          <StackPanel Orientation="Horizontal"><Image Source="KeyBridge.png" Width="36" Height="36" Margin="0,0,10,0" /><TextBlock Text="KeyBridge" Foreground="#F8F6FF" FontSize="25" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="KeyBridge 0.1.2" FontSize="11" Foreground="#9790AB" Margin="6,18,0,0" /><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Navigation" /></ScrollViewer>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="80" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Margin="32,0"><DockPanel VerticalAlignment="Center"><Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="↻  Refresh" Style="{StaticResource Secondary}" Margin="10,0,0,0" Click="RefreshClicked" /><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Margin="0,0,9,0" /><TextBlock x:Name="ShellStatus" FontWeight="SemiBold" /></StackPanel></DockPanel></Border>
      <StackPanel Grid.Row="1"><ProgressBar x:Name="BusyIndicator" IsIndeterminate="True" Visibility="Collapsed" /><Border x:Name="ErrorBanner" Background="{DynamicResource WarningSoftBrush}" CornerRadius="12" Margin="32,16,32,0" Padding="15,12" Visibility="Collapsed"><DockPanel><Button DockPanel.Dock="Right" Content="Dismiss" Style="{StaticResource Secondary}" Margin="12,0,0,0" Padding="10,3" MinHeight="30" Click="DismissError" /><TextBlock x:Name="ErrorText" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" /></DockPanel></Border></StackPanel>
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,28,32,20"><ContentControl x:Name="PageContent" HorizontalContentAlignment="Stretch" /></ScrollViewer>
    </Grid>
  </Grid>
</Window>
