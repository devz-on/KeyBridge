<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>KeyBridge</AssemblyName>
    <RootNamespace>KeyBridge.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>KeyBridge.ico</ApplicationIcon>
    <Version>0.1.2</Version>
    <Authors>KeyBridge contributors</Authors>
    <Description>Local Android-backed FIDO2 transport companion</Description>
    <!-- WPF owns process DPI through the manifest; WinForms is only used for NotifyIcon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="KeyBridge.ico" />
    <ProjectReference Include="../KeyBridge.Core/KeyBridge.Core.csproj" />
    <ProjectReference Include="../KeyBridge.Usb/KeyBridge.Usb.csproj" />
  </ItemGroup>
</Project>
